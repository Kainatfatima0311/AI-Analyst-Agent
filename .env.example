# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored — never commit real secrets.
# ---------------------------------------------------------------------------

# --- Anthropic -------------------------------------------------------------
# Required from Step 7 onward (agent nodes). Steps 0-6 run without it.
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-opus-5

# --- Postgres (container) --------------------------------------------------
POSTGRES_DB=analyst
POSTGRES_USER=app_rw
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Read-only role used by every agent-generated query.
ANALYST_RO_USER=analyst_ro
ANALYST_RO_PASSWORD=change-me-locally-too

# Two DSNs, deliberately separate. The agent's SQL tool only ever gets DB_RO_DSN.
DB_RW_DSN=postgresql://app_rw:change-me-locally@localhost:5432/analyst
DB_RO_DSN=postgresql://analyst_ro:change-me-locally-too@localhost:5432/analyst

# --- Dataset source (optional) --------------------------------------------
# Set both to pull the real Olist dataset from Kaggle. Leave blank and the seeder falls back
# to the deterministic synthetic generator, which is what CI uses. See db/seed/README.md.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- SQL safety limits ----------------------------------------------------
SQL_STATEMENT_TIMEOUT_MS=15000
SQL_IDLE_TX_TIMEOUT_MS=30000
SQL_DEFAULT_ROW_LIMIT=5000
SQL_MAX_EXPLAIN_COST=5000000
ALLOWED_SCHEMAS=analytics

# --- Agent budgets --------------------------------------------------------
MAX_QUERIES_PER_RUN=25
MAX_HYPOTHESES_PER_FINDING=4
MAX_AGENT_ITERATIONS=20
MAX_RUN_WALL_CLOCK_SECONDS=600
APPROVAL_TIMEOUT_SECONDS=1800

# --- Service wiring -------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
LOG_FORMAT=json
